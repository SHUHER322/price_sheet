# Ключ сервисного аккаунта Google (тот же, что в lead_bot)
GOOGLE_CREDENTIALS=credentials.json
# ID таблицы: часть адреса между /d/ и /edit
SPREADSHEET_ID=

# Часовой пояс для времени проверки в таблице
TIMEZONE=Asia/Tomsk

# Сколько страниц загружать одновременно и пауза между запросами к одному сайту (сек)
CONCURRENCY=5
DOMAIN_DELAY=1.5
